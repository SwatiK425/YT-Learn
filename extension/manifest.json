{
  "manifest_version": 3,
  "name": "Praxis: Turn knowledge into skill",
  "version": "0.1.0",
  "description": "Get a hands-on exercise from any YouTube video — built from what the video actually teaches.",
  "permissions": ["storage"],
  "host_permissions": [
    "http://localhost:8003/*",
    "https://www.youtube.com/*",
    "https://youtube.com/*"
  ],
  "action": {
    "default_title": "Praxis",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*", "*://youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["popup/*", "icons/*", "transcript-fetcher.js"],
      "matches": ["*://www.youtube.com/*"]
    }
  ],
  "icons": {
    "128": "icons/icon128.png"
  }
}
